{
  "//": "generated by `denext migrate` — safe to edit; re-running may overwrite. denext is the released JSR build (plan decision D7: T3 consumes released denext only).",
  "tasks": {
    "dev": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.0/cli dev .",
    "build": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.0/cli build .",
    "export": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.0/cli export . && node ../../scripts/apply-web-brand-assets.ts production apps/web/out",
    "start": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.0/cli start .",
    "desktop": "deno task export && deno run -A scripts/package-macos.ts --no-export && open \"dist/T3 Code.app\"",
    "desktop:scripts": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.0/cli desktop package --regenerate-scripts .",
    "desktop:package": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.0/cli desktop package ."
  },
  "nodeModulesDir": "manual",
  "minimumDependencyAge": {
    "exclude": ["jsr:@denext/denext"]
  },
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"],
    "skipLibCheck": true
  },
  "imports": {
    "denext": "jsr:@denext/denext@^3.4.0",
    "denext/jsx-runtime": "jsr:@denext/denext@^3.4.0/jsx-runtime",
    "denext/jsx-dev-runtime": "jsr:@denext/denext@^3.4.0/jsx-dev-runtime",
    "denext/server": "jsr:@denext/denext@^3.4.0/server",
    "denext/client": "jsr:@denext/denext@^3.4.0/client",
    "react": "jsr:@denext/denext@^3.4.0/react",
    "react-dom": "jsr:@denext/denext@^3.4.0/react-dom",
    "react-dom/client": "jsr:@denext/denext@^3.4.0/react-dom/client",
    "react/jsx-runtime": "jsr:@denext/denext@^3.4.0/react/jsx-runtime",
    "react/jsx-dev-runtime": "jsr:@denext/denext@^3.4.0/react/jsx-dev-runtime",
    "react-is": "jsr:@denext/denext@^3.4.0/react-is",
    "denext/desktop": "jsr:@denext/denext@^3.4.0/desktop",
    "denext/desktop/client": "jsr:@denext/denext@^3.4.0/desktop/client",
    "denext/desktop/clerk": "jsr:@denext/denext@^3.4.0/desktop/clerk",
    "denext/desktop/window": "jsr:@denext/denext@^3.4.0/desktop/window",
    "denext/desktop/app": "jsr:@denext/denext@^3.4.0/desktop/app",
    "denext/mobile": "jsr:@denext/denext@^3.4.0/mobile",
    "~/": "./src/",
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/media-types": "jsr:@std/media-types@^1.0.0",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "ws": "npm:ws@^8"
  },
  "compile": {
    "include": [".deno-desktop/app.json"]
  },
  "desktop": {
    "app": {
      "name": "T3 Code",
      "identifier": "com.brainwires.t3code.desktop",
      "icons": {
        "macos": "./desktop-icon.png",
        "linux": "./desktop-icon.png"
      },
      "deepLinks": ["t3code"]
    }
  }
}
