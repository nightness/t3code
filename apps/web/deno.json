{
  "//": "generated by `denext migrate` — safe to edit; re-running may overwrite",
  "tasks": {
    "dev": "deno run -A --node-modules-dir=none jsr:@denext/denext@^2.1.1/cli dev .",
    "build": "deno run -A --node-modules-dir=none jsr:@denext/denext@^2.1.1/cli build .",
    "export": "deno run -A --node-modules-dir=none jsr:@denext/denext@^2.1.1/cli export .",
    "start": "deno run -A --node-modules-dir=none jsr:@denext/denext@^2.1.1/cli start .",
    "desktop": "deno task export && deno desktop --allow-net=127.0.0.1,localhost --allow-read --allow-env --node-modules-dir=none --exclude-unused-npm --include out --icon desktop-icon.png -o \"T3 Code\" desktop.ts"
  },
  "nodeModulesDir": "manual",
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"],
    "skipLibCheck": true
  },
  "imports": {
    "denext": "jsr:@denext/denext@^2.1.1",
    "denext/jsx-runtime": "jsr:@denext/denext@^2.1.1/jsx-runtime",
    "denext/jsx-dev-runtime": "jsr:@denext/denext@^2.1.1/jsx-dev-runtime",
    "denext/server": "jsr:@denext/denext@^2.1.1/server",
    "denext/client": "jsr:@denext/denext@^2.1.1/client",
    "react": "jsr:@denext/denext@^2.1.1/react",
    "react-dom": "jsr:@denext/denext@^2.1.1/react-dom",
    "react-dom/client": "jsr:@denext/denext@^2.1.1/react-dom/client",
    "react/jsx-runtime": "jsr:@denext/denext@^2.1.1/react/jsx-runtime",
    "react/jsx-dev-runtime": "jsr:@denext/denext@^2.1.1/react/jsx-dev-runtime",
    "react-is": "jsr:@denext/denext@^2.1.1/react-is",
    "denext/desktop": "jsr:@denext/denext@^2.1.1/desktop",
    "~/": "./src/"
  }
}
