{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  // expo/tsconfig.base.json's list (an `exclude` here replaces it), plus denext.config.ts: the
  // denext CLI loads that file under Deno, where `denext/server` resolves through deno.json's
  // imports, so it is not part of the Expo app's program (as apps/web keeps its config out).
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "denext.config.ts"
  ]
}
