{
  "//": "generated by `denext migrate` — safe to edit; re-running may overwrite",
  "tasks": {
    "dev": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli dev .",
    "build": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli build .",
    "export": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli export .",
    "start": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli start .",
    "mobile:sync": "deno task export && deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli ota manifest out && npx cap sync",
    "mobile:ios": "npx cap open ios",
    "mobile:android": "npx cap open android",
    "mobile:build:ios": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli mobile build ios",
    "mobile:build:android": "deno run -A --node-modules-dir=none jsr:@denext/denext@^3.4.5/cli mobile build android",
    "web:prepare": "node denext-web/prepare.mjs",
    "export:ios": "deno task web:prepare && DENEXT_PLATFORM=ios deno task export"
  },
  "nodeModulesDir": "manual",
  "minimumDependencyAge": {
    "exclude": ["jsr:@denext/*"]
  },
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "dom", "dom.iterable", "dom.asynciterable"],
    "skipLibCheck": true
  },
  "imports": {
    "denext": "jsr:@denext/denext@^3.4.5",
    "denext/jsx-runtime": "jsr:@denext/denext@^3.4.5/jsx-runtime",
    "denext/jsx-dev-runtime": "jsr:@denext/denext@^3.4.5/jsx-dev-runtime",
    "denext/server": "jsr:@denext/denext@^3.4.5/server",
    "denext/client": "jsr:@denext/denext@^3.4.5/client",
    "react": "jsr:@denext/denext@^3.4.5/react",
    "react-dom": "jsr:@denext/denext@^3.4.5/react-dom",
    "react-dom/client": "jsr:@denext/denext@^3.4.5/react-dom/client",
    "react/jsx-runtime": "jsr:@denext/denext@^3.4.5/react/jsx-runtime",
    "react/jsx-dev-runtime": "jsr:@denext/denext@^3.4.5/react/jsx-dev-runtime",
    "react/compiler-runtime": "jsr:@denext/denext@^3.4.5/react/compiler-runtime",
    "react-is": "jsr:@denext/denext@^3.4.5/react-is",
    "@t3tools/mobile-third-party-licenses": "./.generated/third-party-licenses/index.js",
    "@t3tools/mobile-device-stream": "./.generated/device-stream/index.js",
    "react-native-nitro-modules": "./denext-web/nitro-modules.ts",
    "react-native-image-viewing": "./denext-web/react-native-image-viewing.tsx"
  }
}
